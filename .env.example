# MongoDB Atlas Connection String (Required for production / persistent Atlas storage)
# Get this from MongoDB Atlas -> Connect -> Drivers (e.g. mongodb+srv://...)
# If omitted in local development, PeerUp starts a temporary local MongoDB instance for previewing.
MONGODB_URI=

# JWT Secret for signing session tokens (set a long random string in production)
# If omitted, PeerUp generates a secure ephemeral secret in memory at startup.
JWT_SECRET=

# Optional: Set to "false" to disable automatic demo data seeding on empty databases
SEED_DEMO_DATA=true

# Optional: Frontend origin for CORS in split deployments (e.g. https://peerup.vercel.app)
CLIENT_ORIGIN=

# APP_URL: Automatically injected in AI Studio preview
APP_URL=

# Optional: Server passcode or comma-separated emails allowed to claim Admin console access
ADMIN_CLAIM_PASSCODE=
ADMIN_EMAILS=
